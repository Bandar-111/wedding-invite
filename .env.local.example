# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for /admin (choose your own)
ADMIN_PASSWORD=change-me

# Passcode for /scanner (share with entrance staff only, choose your own)
STAFF_PASSCODE=1234

# Random long random string used to sign login sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
